rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Compliance files are served through authenticated API routes and
    // one-hour signed URLs. The client SDK cannot read or write objects.
    match /companies/{companyId}/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
