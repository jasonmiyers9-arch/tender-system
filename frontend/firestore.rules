rules_version = '2';

// Clients never read or write application data. The Next.js API uses the
// Admin SDK, which bypasses these rules. Admin audit reads require a role
// custom claim set by the server. Signup cannot set that claim.
service cloud.firestore {
  match /databases/{database}/documents {
    function isStaff() {
      return request.auth != null
        && request.auth.token.role in ['admin', 'super_admin'];
    }

    match /security_audit_logs/{logId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /audit_log/{logId} {
      allow read: if isStaff();
      // Append-only. The Admin SDK writes these. Clients cannot change them.
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read, write: if false;
    }

    match /companies/{companyId} {
      allow read, write: if false;
    }

    match /documents/{documentId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
